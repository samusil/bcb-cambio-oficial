<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F3EBDD"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BCB"
        android:textColor="#B08D2C"
        android:textSize="58sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:shadowColor="#E8D79A"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8" />

    <View
        android:layout_width="80dp"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="#006B54" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="TIPO DE CAMBIO OFICIAL"
        android:textColor="#1F1F1F"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Banco Central de Bolivia"
        android:textColor="#5F5A52"
        android:textSize="15sp" />

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:indeterminateTint="#006B54" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Consultando información oficial..."
        android:textColor="#6D675E"
        android:textSize="14sp" />

</LinearLayout>